# Copy to .env.local and fill with real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase persistence (M5 phase 2). Server-only key: NO NEXT_PUBLIC prefix.
# Flip HQ_PERSISTENCE to true only after applying supabase/migrations and
# running an initial sync (POST /api/sync/ghl).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
HQ_PERSISTENCE=false
CRON_SECRET=generate-a-long-random-string
# Shared secret for /api/webhooks/ghl (header x-hq-webhook-secret or ?token=).
# Set the same value in the GHL workflow webhook action. Unset = endpoint off.
GHL_WEBHOOK_SECRET=generate-another-long-random-string
# Shared secret for /api/webhooks/kahunas (Kahunas -> Zapier intake). Set the
# same value as ?token= in the Zapier "Webhooks by Zapier" POST action. Unset =
# endpoint off. See docs/kahunas-integration.md.
KAHUNAS_WEBHOOK_SECRET=generate-a-third-long-random-string

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# M6 auth switch: set to "clerk" ONLY after docs/auth-activation.md steps 1-5.
# Unset = password gate only (today's behaviour).
AUTH_MODE=

# Stripe (Financials: real cash, refunds, payment history). Server-only, NO
# NEXT_PUBLIC. Inert until set; until then Financials shows the MRR run-rate
# estimate. Read-only use; never expose to the browser.
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key

# OUTREACH KILL-SWITCH (owner safety rule: NO ONE GETS CONTACTED).
# Every outbound-contact path (Inbox send, GHL message write-back, automation
# sends) checks src/lib/outreach-guard.ts, which is OFF unless this is exactly
# "true". Leave unset/false during development so no client or lead is ever
# contacted. Flip to true only when you deliberately want real sends to fire.
OUTREACH_ENABLED=false

# Team Slack pings (internal only, never client-facing; see src/lib/slack.ts).
# One incoming-webhook URL for the team channel; unset = all pings silently
# skip. Standard is a DIRECT Slack incoming webhook, not Zapier (R2-6).
# Ping types: Journey Tracker assign (B4), check-in logged (R2-6a), and the
# onboarding review/approved/sent family (R2-6b).
SLACK_WEBHOOK_URL=

# R2-6: per-type ping toggles. Unset = ON; set "false" to silence that type
# without touching the others.
SLACK_PING_ASSIGN=
SLACK_PING_CHECKIN=
SLACK_PING_ONBOARDING=

# R5-3: Typeform webhook intake for client feedback forms. Each coach's
# Typeform points its webhook at
#   /api/webhooks/typeform?token=<this>&coach=<coach first name>
# Generate a fresh 64-hex string; unset = the endpoint refuses everything.
TYPEFORM_WEBHOOK_SECRET=

# Check-in corrections lock (I2, FEEDBACK-V2 open question 7). Default
# unset/false = the sheets behaviour: coaches mark/correct their OWN roster's
# weekly check-ins (codes drive pay). Set "true" to restrict check-in writes
# to owner/VA/head coach only; the coach week grid goes read-only.
CHECKIN_EDITS_ADMIN_ONLY=false
